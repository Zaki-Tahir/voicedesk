NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Public HTTPS URL that Twilio can reach (an ngrok/cloudflared tunnel in development)
PUBLIC_URL=https://your-tunnel.example.com

DATABASE_URL=postgresql://voicedesk:voicedesk@localhost:5432/voicedesk
REDIS_URL=redis://localhost:6379

OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
OPENAI_SUMMARY_MODEL=gpt-4.1-mini

# Leave the Twilio credentials empty to print SMS to the console instead of sending
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VALIDATE_SIGNATURE=true

# Service account JSON (single line). Leave empty to use an in-memory calendar.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Shared secret between the dashboard and the API. Generate with: openssl rand -hex 32
ADMIN_API_TOKEN=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:3000
