# Where the VoiceDesk API is running
API_URL=http://localhost:8080
# Must match ADMIN_API_TOKEN on the server
ADMIN_API_TOKEN=change-me-to-a-long-random-string
# Optional: which business to show. Defaults to the first one.
BUSINESS_ID=
# Optional: protect the dashboard with HTTP basic auth (user "admin")
DASHBOARD_PASSWORD=
